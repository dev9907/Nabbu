2. VPC PEERING
==============================================================================

2.1 What is VPC Peering?
- Direct network connection between two VPCs
- Enables private communication without internet
- Works within same region or across regions
- Low latency, high bandwidth

2.2 VPC Peering Benefits:
  ✓ Private connectivity
  ✓ Cost-effective (no data transfer charges within region)
  ✓ Simple setup
  ✓ Full network functionality
  ✗ Limitations: No transitive peering (A-B, B-C ≠ A-C)

2.3 Peering Connection Flow:
  VPC-A (10.0.0.0/16) ←→ VPC-B (172.16.0.0/16)
  
  Step 1: Request peering connection
  Step 2: Accept peering connection
  Step 3: Update route tables in both VPCs
  Step 4: Configure security groups/NACLs

==============================================================================
3. TERRAFORM CODE - VPC SETUP
==============================================================================

provider "aws" {
  region = "us-east-1"
}

# VPC-A Configuration
resource "aws_vpc" "vpc_a" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true
  
  tags = {
    Name = "VPC-A"
  }
}

# VPC-B Configuration
resource "aws_vpc" "vpc_b" {
  cidr_block           = "172.16.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true
  
  tags = {
    Name = "VPC-B"
  }
}

# Public Subnet in VPC-A
resource "aws_subnet" "public_subnet_a" {
  vpc_id                  = aws_vpc.vpc_a.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = "us-east-1a"
  map_public_ip_on_launch = true
  
  tags = {
    Name = "Public-Subnet-A"
  }
}

# Private Subnet in VPC-B
resource "aws_subnet" "private_subnet_b" {
  vpc_id            = aws_vpc.vpc_b.id
  cidr_block        = "172.16.10.0/24"
  availability_zone = "us-east-1a"
  
  tags = {
    Name = "Private-Subnet-B"
  }
}

# Internet Gateway for VPC-A
resource "aws_internet_gateway" "igw_a" {
  vpc_id = aws_vpc.vpc_a.id
  
  tags = {
    Name = "IGW-A"
  }
}

# Route Table for VPC-A
resource "aws_route_table" "rt_a" {
  vpc_id = aws_vpc.vpc_a.id
  
  route {
    cidr_block      = "0.0.0.0/0"
    gateway_id      = aws_internet_gateway.igw_a.id
  }
  
  tags = {
    Name = "RouteTable-A"
  }
}

# Associate Route Table with Subnet
resource "aws_route_table_association" "rta" {
  subnet_id      = aws_subnet.public_subnet_a.id
  route_table_id = aws_route_table.rt_a.id
}


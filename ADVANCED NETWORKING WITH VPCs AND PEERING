4. VPC PEERING TERRAFORM CODE
==============================================================================

# Create Peering Connection
resource "aws_vpc_peering_connection" "peer_a_to_b" {
  vpc_id        = aws_vpc.vpc_a.id
  peer_vpc_id   = aws_vpc.vpc_b.id
  auto_accept   = true
  
  tags = {
    Name = "VPC-A-to-VPC-B-Peering"
  }
}

# Route in VPC-A for peering traffic
resource "aws_route" "route_peer_a" {
  route_table_id            = aws_route_table.rt_a.id
  destination_cidr_block    = "172.16.0.0/16"
  vpc_peering_connection_id = aws_vpc_peering_connection.peer_a_to_b.id
}

# Route Table for VPC-B
resource "aws_route_table" "rt_b" {
  vpc_id = aws_vpc.vpc_b.id
  
  tags = {
    Name = "RouteTable-B"
  }
}

# Route in VPC-B for peering traffic
resource "aws_route" "route_peer_b" {
  route_table_id            = aws_route_table.rt_b.id
  destination_cidr_block    = "10.0.0.0/16"
  vpc_peering_connection_id = aws_vpc_peering_connection.peer_a_to_b.id
}

# Associate Route Table with VPC-B Subnet
resource "aws_route_table_association" "rtb" {
  subnet_id      = aws_subnet.private_subnet_b.id
  route_table_id = aws_route_table.rt_b.id
}


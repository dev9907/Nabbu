5. SECURITY GROUPS CONFIGURATION
==============================================================================

# Security Group for VPC-A (Allow inbound from VPC-B)
resource "aws_security_group" "sg_a" {
  name        = "sg-vpc-a"
  description = "Security group for VPC-A"
  vpc_id      = aws_vpc.vpc_a.id
  
  ingress {
    from_port   = 0
    to_port     = 65535
    protocol    = "tcp"
    cidr_blocks = ["172.16.0.0/16"]  # Allow from VPC-B
  }
  
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  
  tags = {
    Name = "SG-VPC-A"
  }
}

# Security Group for VPC-B (Allow inbound from VPC-A)
resource "aws_security_group" "sg_b" {
  name        = "sg-vpc-b"
  description = "Security group for VPC-B"
  vpc_id      = aws_vpc.vpc_b.id
  
  ingress {
    from_port   = 0
    to_port     = 65535
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]  # Allow from VPC-A
  }
  
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  
  tags = {
    Name = "SG-VPC-B"
  }
}


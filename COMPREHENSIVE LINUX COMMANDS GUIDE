## EXAMPLE USAGE

# File Operations
ls -la                          # List all files with details
find / -name "*.txt" 2>/dev/null  # Find all txt files
cp -r source/ destination/      # Copy directory recursively

# Text Processing
grep "pattern" file.txt         # Search pattern
cat file1 file2 | grep "word"   # Pipe and search
sed 's/old/new/g' file.txt      # Replace text

# System Info
uname -a                        # System information
ps aux                          # All processes
df -h                           # Disk usage human readable

# Networking
ping -c 4 google.com            # Test connectivity
curl http://example.com         # Fetch URL
ssh user@hostname               # Secure shell access

# Compression
tar -czf archive.tar.gz dir/    # Create gzip archive
unzip file.zip                  # Extract zip file

# Permissions
chmod 755 script.sh             # Set permissions
chown user:group file           # Change owner
